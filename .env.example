# SharePoint Configuration
SHAREPOINT_CLIENT_ID=your-azure-app-client-id-here
SHAREPOINT_CLIENT_SECRET=your-azure-app-client-secret-here
SHAREPOINT_TENANT_ID=your-azure-tenant-id-here
SHAREPOINT_SITE_ID=your-sharepoint-site-id-here
SHAREPOINT_FILE_PATH=/sites/YourSite/Shared Documents/yourfile.csv

# RapidAPI Configuration (Optional but recommended)
RAPIDAPI_PROXY_SECRET=generate-a-random-secure-string-here
